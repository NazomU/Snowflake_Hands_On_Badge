USE SCHEMA MAILERS;

CREATE OR REPLACE VIEW DENVER_ZIPS AS
(SELECT postal_code
from weathersource.onpoint_id.postal_codes
where country = 'US'
and postal_code like '8020%');

select * from denver_zips;

CREATE OR REPLACE VIEW HISTORY_DAY AS
SELECT postal_code, 
        country, 
        city_name
FROM WEATHERSOURCE.ONPOINT_ID.HISTORY_DAY;

SELECT count(*) FROM HISTORY_DAY;


select count(*)
from history_day hd
join denver_zips dz on hd.postal_code = dz.postal_code;

--#what days in the next few weeks are expected to be sunny and clear
select max(date_valid_std), min(date_valid_std)
from weathersource.onpoint_id.history_day hd
join denver_zips dz on hd.postal_code=dz.postal_code;

select max(date_valid_std), min(date_valid_std)
from weathersource.onpoint_id.forecast_day hd
join denver_zips dz on hd.postal_code=dz.postal_code;

--Can the Data Tell Me Which Day in the Next 2 Weeks Would Be Best for a Sale
--use the field with Average Cloud Cover Percentage since sunny days will generally be the best days in Detroit, regardless of whether it's winter or summer.

select date_valid_std, avg(avg_cloud_cover_tot_pct)
from weathersource.onpoint_id.forecast_day fd
join denver_zips dz 
on fd.postal_code=dz.postal_code
group by date_valid_std
order by avg(avg_cloud_cover_tot_pct);
